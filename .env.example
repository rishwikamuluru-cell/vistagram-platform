# ==============================================================================
# VISTAGRAM ULTIMATE 3.0 — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# NEVER commit .env.local or secret keys to Git!
# ==============================================================================

# 1. SUPABASE PROJECT URL
# Find in: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# 2. SUPABASE PUBLISHABLE / ANON KEY (Safe for browser client with RLS enabled)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# 3. SUPABASE SERVER-ONLY SECRET / SERVICE ROLE KEY
# STRICTLY SERVER-SIDE ONLY! Never prefix with NEXT_PUBLIC_ or import in client components.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_service_role_key_here"

# 4. APPLICATION PUBLIC URL (Used for email verification & password recovery redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 5. LIVEKIT CLOUD REAL-TIME VOICE & VIDEO CALLING (https://cloud.livekit.io/)
# Public WebSocket URL is safe for client connection; API Key & Secret are SERVER-ONLY!
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_WEBHOOK_SECRET=""

# 6. OPTIONAL WEB PUSH VAPID KEYS (For browser push notifications)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# 7. OPTIONAL GOOGLE OAUTH PROVIDER
NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH="false"

# 8. UPLOAD SIZE LIMITS
NEXT_PUBLIC_MAX_IMAGE_SIZE_MB="10"
NEXT_PUBLIC_MAX_VIDEO_SIZE_MB="50"
